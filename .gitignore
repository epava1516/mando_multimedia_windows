# Only the stable Android app and its Windows helper belong to this repository.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CHANGELOG.md
!/SECURITY.md
!/android/
!/windows-lock/
!/windows-zoom/
!/windows-server/
!/evidence/
!/web-downloads/

# Local signing material and generated artifacts.
.state/
**/__pycache__/
*.pyc
android/build/
android/*.apk
android/*.idsig
windows-lock/*.zip
windows-zoom/*.zip
windows-zoom/*.exe

# Historical investigation dumps stay local.
evidence/*
!evidence/README.md
!evidence/PINCH_ZOOM.md
!evidence/HORIZONTAL_SCROLL.md
!evidence/CLIPBOARD.md
!evidence/LEAN_IR.md
