# Only the stable Android app and its Windows helper belong to this repository.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CHANGELOG.md
!/SECURITY.md
!/android/
!/windows-lock/
!/windows-zoom/
!/windows-server/
!/evidence/

# Local signing material and generated artifacts.
.state/
**/__pycache__/
*.pyc
android/build/
android/*.apk
android/*.idsig
windows-lock/*.zip
windows-zoom/*.zip
windows-zoom/*.exe

# Historical investigation dumps stay local.
evidence/*
!evidence/README.md
!evidence/PINCH_ZOOM.md
!evidence/LEAN_IR.md
!evidence/lgtv1-exact-codes.json

# Historical validation notes and device-only probes.
android/VALIDATION*.md
!android/VALIDATION-0.4.1.md
!android/VALIDATION-0.4.2-rc.2.md
!android/VALIDATION-0.5.0-alpha.1.md
android/tests/KeyboardProbe.java

node_modules/

windows-server/.venv/
windows-server/*.zip
